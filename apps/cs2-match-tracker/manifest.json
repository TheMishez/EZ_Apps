{
  "id": "cs2-match-tracker",
  "name": "CS2 Match Tracker",
  "version": "0.1.0",
  "author": "EZGGco",
  "description": "See everyone in your match with FACEIT level + Elo, Premier and Leetify ratings, win rate and K/D, plus quick csrep, Leetify and FACEIT buttons. Alt+X to show/hide.",
  "entry": "index.html",
  "games": ["cs2"],
  "launch": "with-game",
  "window": { "overlay": true, "width": 1000, "height": 600, "clickThrough": false, "startHidden": true },
  "permissions": ["cs2.gsi", "cs2.console", "hotkeys", "storage", "net", "links"],
  "hotkeys": [
    { "id": "toggle", "default": "Alt+X" },
    { "id": "refresh", "default": "Alt+R" }
  ],
  "net": ["open.faceit.com", "api-public.cs-prod.leetify.com"],
  "links": ["csrep.gg", "leetify.com", "www.faceit.com", "steamcommunity.com"]
}
